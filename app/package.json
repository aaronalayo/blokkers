  "dependencies": {
    "bluebird": "^3.5.1",
    "body-parser": "^1.19.0",
    "connect-mongodb-session": "^2.4.1",
    "cookie-parser": "^1.4.5",
    "cookie-session": "^1.4.0",
    "cross-env": "^7.0.3",
    "dotenv": "^8.6.0",
    "easy-ftp": "^0.4.2",
    "express": "^4.17.1",
    "express-limiter": "^1.6.1",
    "express-session": "^1.17.1",
    "fs-extra": "^9.1.0",
