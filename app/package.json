{
  "name": "blokkers",
  "version": "1.0.0",
  "description": "Blokkers API to sell design posters",
  "main": "src/app.js",
  "scripts": {
    "migrate:latest": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "knex migrate:rollback",
    "seed:make": "knex seed:make",
    "seed:run": "knex seed:run",
    "cleandb": "knex migrate:rollback && knex migrate:latest && knex seed:run",
    "start": "cross-env PORT=80 node src/app.js",
    "start-dev": "cross-env PORT=2000 nodemon src/app.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronalayo/blokkers.git"
  },
  "author": "Maria Ilieva / Aaron ALAYO",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aaronalayo/blokkers/issues"
  },
  "homepage": "https://github.com/aaronalayo/blokkers#readme",
  "dependencies": {
    "cross-env": "^7.0.2",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "helmet": "^4.2.0",
    "knex": "^0.21.12",
    "nodemon": "^2.0.6",
    "objection": "^2.2.3",
    "pg": "^8.5.1"
  }
}
